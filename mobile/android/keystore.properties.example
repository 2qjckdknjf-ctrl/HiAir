# Copy to mobile/android/keystore.properties (gitignored) and fill in values.
# storeFile is relative to mobile/android/ (NOT app/).
# Full guide: docs/release/ANDROID_RELEASE_SIGNING_GUIDE.md
#
# Alternate (PR #27 / CI): set env vars instead:
#   ANDROID_KEYSTORE_PATH, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
#   Keystore file often named upload-keystore.jks, alias hiair-upload
#
# Generate keystore (owner, one-time — only if no existing key):
#   keytool -genkeypair -v -keystore hiair-release.keystore -alias hiair \
#     -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12
storeFile=hiair-release.keystore
storePassword=CHANGE_ME
keyAlias=hiair
keyPassword=CHANGE_ME
