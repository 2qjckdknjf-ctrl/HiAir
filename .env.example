# Backend
DATABASE_URL=postgresql://hiair:hiair@localhost:5432/hiair
DIRECT_DATABASE_URL=postgresql://hiair:hiair@localhost:5432/hiair
JWT_SECRET=replace-with-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=120
REFRESH_TOKEN_TTL_DAYS=30
APP_ENV=development
HIAIR_ALLOW_INSECURE_LOCAL_DEV=false
ALLOW_LEGACY_USER_HEADER_AUTH=false
# Protected deploys force ENVIRONMENT_ALLOW_SAMPLE_FALLBACK=false (no synthetic air data).
ENVIRONMENT_ALLOW_SAMPLE_FALLBACK=true
HIAIR_AUTH_PROVIDER=supabase
HIAIR_AUTH_LEGACY_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
HIAIR_IOS_URL_SCHEME=hiair
HIAIR_ANDROID_URL_SCHEME=hiair
HIAIR_AUTH_REDIRECT_URI=hiair://auth/callback
SUBSCRIPTION_PROVIDER=stub
SUBSCRIPTION_WEBHOOK_SECRET=
APPLE_STORE_VERIFIER_MODE=stub
GOOGLE_PLAY_VERIFIER_MODE=stub
APPLE_BUNDLE_ID=com.hiair.app
APPLE_STORE_ENVIRONMENT=sandbox
APPLE_APP_APPLE_ID=
GOOGLE_PLAY_PACKAGE_NAME=com.hiair
# Live store verification (production only):
# APPLE_STORE_VERIFIER_MODE=live
# APPLE_STORE_ENVIRONMENT=production
# APPLE_APP_APPLE_ID=1234567890
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Data providers (defaulted for MVP)
WEATHER_API_PROVIDER=openweathermap
WEATHER_API_KEY=
AQI_API_PROVIDER=waqi
AQI_API_KEY=
# Optional no-key providers:
# WEATHER_API_PROVIDER=openmeteo
# AQI_API_PROVIDER=openmeteo

# Optional LLM explanation layer
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_PROMPT_VERSION=hiair-expl-v1
OPENAI_RATE_LIMIT_PER_MINUTE=60
OPENAI_HTTP_TIMEOUT_SECONDS=8
OPENAI_MAX_TOKENS=120

# Notifications adapters
NOTIFICATIONS_PROVIDER_MODE=stub
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_AUTH_TOKEN=
APNS_TOPIC=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BACKOFF_MS=300
NOTIFICATION_SECRET_ROTATION_DAYS=30
NOTIFICATION_ADMIN_TOKEN=
RETENTION_NOTIFICATION_DELIVERY_ATTEMPTS_DAYS=90
RETENTION_NOTIFICATION_EVENTS_DAYS=180
RETENTION_SUBSCRIPTION_WEBHOOK_EVENTS_DAYS=180
RETENTION_SECRET_ROTATION_EVENTS_DAYS=365

# Secret source (env | file | http | vault)
SECRET_SOURCE=env
SECRET_FILE_PATH=
SECRET_HTTP_URL=
SECRET_HTTP_TOKEN=
SECRET_HTTP_TIMEOUT_MS=4000
SECRET_CACHE_TTL_SECONDS=60
VAULT_ADDR=
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_KV_MOUNT=secret
VAULT_KV_PATH=hiair
